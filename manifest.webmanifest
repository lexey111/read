{
  "name": "WebReader",
  "short_name": "WebReader",
  "description": "A book reader in the browser: EPUB, FB2, MOBI, AZW3, PDF, CBZ, Markdown, TXT and HTML. Your books stay on your device.",
  "id": "./",
  "start_url": "./?app",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8f1e3",
  "theme_color": "#f8f1e3",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/epub+zip": [".epub"],
        "application/x-fictionbook+xml": [".fb2"],
        "application/x-mobipocket-ebook": [".mobi", ".azw3", ".azw", ".prc"],
        "application/pdf": [".pdf"],
        "application/vnd.comicbook+zip": [".cbz"],
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"],
        "application/zip": [".zip"]
      },
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "book",
          "accept": [".epub", ".fb2", ".mobi", ".azw3", ".pdf", ".cbz", ".zip", ".md", ".markdown", ".txt", ".html", ".htm",
            "application/epub+zip", "application/x-mobipocket-ebook", "application/pdf", "application/zip", "application/x-zip-compressed",
            "application/vnd.comicbook+zip", "application/x-fictionbook+xml", "text/plain", "text/markdown", "text/html",
            "application/octet-stream"]
        }
      ]
    }
  }
}
